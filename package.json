{
  "name": "pi-desktop",
  "productName": "Pi Desktop",
  "version": "0.12.1",
  "description": "Pi Desktop — Electron 桌面壳：在主进程内嵌 pi-web 的 Next 服务器（含 pi agent），渲染层同源加载 Pi Web UI",
  "main": ".vite/build/main.js",
  "author": "fellow99",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "typecheck": "tsc --noEmit",
    "prepare:next": "node scripts/prepare-next.mjs",
    "smoke": "node scripts/smoke-desktop.mjs",
    "probe:renderer": "node scripts/probe-renderer.mjs",
    "collect:pi": "node scripts/collect-pi.mjs",
    "pin:upstream": "node scripts/pin-upstream.mjs",
    "brand": "node scripts/brand-assets.mjs",
    "prepackage": "node scripts/prepare-next.mjs && node scripts/collect-pi.mjs",
    "premake": "node scripts/prepare-next.mjs && node scripts/collect-pi.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^24.3.0",
    "electron": "43.7.9",
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  }
}
