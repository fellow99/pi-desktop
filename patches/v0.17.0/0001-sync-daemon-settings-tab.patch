diff --git a/components/SyncConfig.tsx b/components/SyncConfig.tsx
new file mode 100644
index 0000000..3b48d84
--- /dev/null
+++ b/components/SyncConfig.tsx
@@ -0,0 +1,259 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState, type CSSProperties } from "react";
+import { useI18n } from "@/hooks/useI18n";
+import { ConfigButton, ConfigField, ConfigStatusDot, ConfigSwitch } from "./SettingsUi";
+
+/**
+ * Pi Desktop's 中枢服务（sync-daemon）settings section.
+ *
+ * The shell owns the daemon and the config file; this panel is a thin form over
+ * `window.piDesktopSync` (exposed by the desktop preload only on the embedded
+ * app origin). Without that bridge the section is not listed at all, so a
+ * patched pi-web opened in a plain browser never shows a dead entry.
+ */
+
+type SyncStatus =
+  | { state: "disabled" }
+  | { state: "starting" }
+  | { state: "running" }
+  | { state: "stopped"; reason?: string };
+
+type SyncSettings = {
+  enabled: boolean;
+  hubUrl: string;
+  hostName: string;
+  hubToken: string;
+};
+
+type SyncBridge = {
+  get: () => Promise<{ settings: SyncSettings; status: SyncStatus }>;
+  apply: (settings: SyncSettings) => Promise<{ ok: true }>;
+};
+
+declare global {
+  interface Window {
+    piDesktopSync?: SyncBridge;
+  }
+}
+
+export function hasSyncBridge(): boolean {
+  return typeof window !== "undefined" && typeof window.piDesktopSync?.get === "function";
+}
+
+const POLL_MS = 2500;
+
+const inputStyle: CSSProperties = {
+  width: "100%",
+  minWidth: 0,
+  height: 34,
+  padding: "0 9px",
+  border: "1px solid var(--border)",
+  borderRadius: 5,
+  background: "var(--bg)",
+  color: "var(--text)",
+  fontSize: 12,
+  outline: "none",
+  fontFamily: "inherit",
+};
+
+/** The shell reports these verbatim (they are user-facing, not internal); map them to the active locale. */
+const ERROR_KEYS: Record<string, string> = {
+  "中枢服务地址不能为空": "settings.syncErrorHubUrlRequired",
+  "中枢服务地址必须是 http(s) URL": "settings.syncErrorHubUrlProtocol",
+  "中枢服务地址不是合法 URL": "settings.syncErrorHubUrlInvalid",
+  "本端名称不能为空": "settings.syncErrorHostNameRequired",
+  "本端令牌不能为空": "settings.syncErrorTokenRequired",
+  "设置数据格式不正确，请重试": "settings.syncErrorPayload",
+  "内嵌服务尚未就绪，请稍后再试": "settings.syncErrorRuntime",
+  "拒绝：非法调用来源": "settings.syncErrorForbidden",
+};
+
+function describeError(cause: unknown, translate: (key: string) => string): string {
+  const raw = cause instanceof Error ? cause.message : String(cause);
+  // Strip Electron's IPC wrapper: "Error invoking remote method 'x': Error: <message>".
+  const message = raw.replace(/^Error invoking remote method '[^']*':\s*(?:Error:\s*)?/, "").trim();
+  const key = ERROR_KEYS[message];
+  return key ? translate(key) : message;
+}
+
+function statusLabel(status: SyncStatus | null, translate: (key: string, params?: Record<string, string>) => string): string {
+  if (!status) return translate("settings.syncUnknown");
+  switch (status.state) {
+    case "running":
+      return translate("settings.syncRunning");
+    case "starting":
+      return translate("settings.syncStarting");
+    case "disabled":
+      return translate("settings.syncDisabled");
+    case "stopped":
+      return status.reason
+        ? translate("settings.syncStoppedWithReason", { reason: status.reason })
+        : translate("settings.syncStopped");
+  }
+}
+
+export function SyncConfig() {
+  const { t } = useI18n();
+  const tRef = useRef(t);
+  tRef.current = t;
+  const [settings, setSettings] = useState<SyncSettings | null>(null);
+  const [status, setStatus] = useState<SyncStatus | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [saving, setSaving] = useState(false);
+  const [showToken, setShowToken] = useState(false);
+  const [message, setMessage] = useState<{ kind: "ok" | "error"; text: string } | null>(null);
+  const loadedRef = useRef(false);
+
+  useEffect(() => {
+    if (loadedRef.current) return;
+    loadedRef.current = true;
+    const bridge = window.piDesktopSync;
+    if (!bridge) {
+      setLoading(false);
+      return;
+    }
+    let cancelled = false;
+    void bridge.get()
+      .then((data) => {
+        if (cancelled) return;
+        setSettings(data.settings);
+        setStatus(data.status);
+        setLoading(false);
+      })
+      .catch((cause: unknown) => {
+        if (cancelled) return;
+        setLoading(false);
+        setMessage({ kind: "error", text: describeError(cause, tRef.current) });
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  // Status only: never overwrites fields the user is editing. Stops when the section unmounts.
+  useEffect(() => {
+    const bridge = window.piDesktopSync;
+    if (!bridge) return;
+    let cancelled = false;
+    const timer = setInterval(() => {
+      void bridge.get()
+        .then((data) => {
+          if (!cancelled) setStatus(data.status);
+        })
+        .catch(() => undefined);
+    }, POLL_MS);
+    return () => {
+      cancelled = true;
+      clearInterval(timer);
+    };
+  }, []);
+
+  const update = (patch: Partial<SyncSettings>) => {
+    setSettings((current) => (current ? { ...current, ...patch } : current));
+  };
+
+  const apply = useCallback(async () => {
+    const bridge = window.piDesktopSync;
+    if (!bridge || !settings) return;
+    setSaving(true);
+    setMessage(null);
+    try {
+      await bridge.apply(settings);
+      setMessage({ kind: "ok", text: tRef.current("settings.syncApplied") });
+      const data = await bridge.get();
+      setSettings(data.settings);
+      setStatus(data.status);
+    } catch (cause) {
+      setMessage({ kind: "error", text: describeError(cause, tRef.current) });
+    } finally {
+      setSaving(false);
+    }
+  }, [settings]);
+
+  const controlsDisabled = loading || settings === null;
+
+  return (
+    <div className="settings-general">
+      <section className="settings-general-section">
+        <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 16 }}>
+          <span style={{ color: "var(--text-muted)", fontSize: 12 }}>{t("settings.syncStatus")}</span>
+          <ConfigStatusDot active={status ? status.state === "running" : undefined} />
+          <span style={{ fontSize: 12 }}>{statusLabel(status, t)}</span>
+        </div>
+
+        <div style={{ display: "grid", gap: 12 }}>
+          <ConfigField label={t("settings.syncHubUrl")}>
+            <input
+              style={inputStyle}
+              aria-label={t("settings.syncHubUrl")}
+              value={settings?.hubUrl ?? ""}
+              disabled={controlsDisabled}
+              placeholder="http://127.0.0.1:12380"
+              spellCheck={false}
+              autoComplete="off"
+              onChange={(event) => update({ hubUrl: event.target.value })}
+            />
+          </ConfigField>
+
+          <ConfigField label={t("settings.syncHostName")}>
+            <input
+              style={inputStyle}
+              aria-label={t("settings.syncHostName")}
+              value={settings?.hostName ?? ""}
+              disabled={controlsDisabled}
+              spellCheck={false}
+              autoComplete="off"
+              onChange={(event) => update({ hostName: event.target.value })}
+            />
+          </ConfigField>
+
+          <ConfigField label={t("settings.syncToken")}>
+            <div style={{ display: "flex", gap: 6 }}>
+              <input
+                style={inputStyle}
+                aria-label={t("settings.syncToken")}
+                type={showToken ? "text" : "password"}
+                value={settings?.hubToken ?? ""}
+                disabled={controlsDisabled}
+                spellCheck={false}
+                autoComplete="off"
+                onChange={(event) => update({ hubToken: event.target.value })}
+              />
+              <ConfigButton size="small" variant="secondary" disabled={controlsDisabled} onClick={() => setShowToken((current) => !current)}>
+                {showToken ? t("settings.syncHideToken") : t("settings.syncShowToken")}
+              </ConfigButton>
+            </div>
+          </ConfigField>
+
+          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
+            <span style={{ color: "var(--text-muted)", fontSize: 12 }}>{t("settings.syncEnabled")}</span>
+            <ConfigSwitch
+              checked={settings?.enabled === true}
+              disabled={controlsDisabled}
+              label={t("settings.syncEnabled")}
+              onChange={(enabled) => update({ enabled })}
+            />
+          </div>
+
+          <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
+            <ConfigButton variant="primary" disabled={controlsDisabled || saving} onClick={() => void apply()}>
+              {saving ? t("settings.syncApplying") : t("settings.syncApply")}
+            </ConfigButton>
+            {message && (
+              <span
+                role={message.kind === "error" ? "alert" : "status"}
+                className={message.kind === "error" ? "settings-general-error" : "settings-general-description"}
+                style={message.kind === "ok" ? { margin: 0, color: "var(--accent)" } : { margin: 0 }}
+              >
+                {message.text}
+              </span>
+            )}
+          </div>
+        </div>
+
+        {loading && <p className="settings-general-description">{t("settings.syncLoading")}</p>}
+      </section>
+    </div>
+  );
+}
